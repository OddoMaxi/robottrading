ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://arbitrage:arbitrage@localhost:5432/arbitrage
REDIS_URL=redis://localhost:6379/0

API_HOST=0.0.0.0
API_PORT=8000

# Phase 2D (user directive, 2026-08-23) — REAL Binance mainnet, READ-ONLY.
# Provision this key with reading permissions ONLY on the Binance side —
# no spot/margin trading permission required for this phase, and
# withdrawal permission must be OFF. Never committed, never logged.
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Phase 2D — PAPER/LIVE separation (never conflate these two).
PAPER_CAPITAL_USD=10000.0
MICRO_LIVE_CAP_USDT=10.0
MAX_LIVE_CAPITAL_USDT=10.0
# Hard default OFF. Do not flip without explicit authorization for the
# next step (first real order) — this phase remains read-only regardless.
LIVE_TRADING_ENABLED=false
